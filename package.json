{
  "name": "karaoke-server",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @karaoke/web --filter @karaoke/server dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @karaoke/server test",
    "start": "pnpm --filter @karaoke/server start"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
